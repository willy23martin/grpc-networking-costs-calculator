{
  "openapi": "3.0.1",
  "info": {
    "title": "gRPC-Based TCO Cost-Efficiency Calculator API",
    "description": "Comprehensive OpenAPI contract specifying the FinOps strategies, session operations, protocol buffer compilation, and quality attribute trade-off calculator controllers.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:8080",
      "description": "Local Development Server"
    }
  ],
  "paths": {
    "/": {
      "post": {
        "tags": ["TCO Calculator Workspace"],
        "summary": "Compile Protocol Buffer configurations and compute interactive architectural trade-offs",
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "protoFile": {
                    "type": "string",
                    "format": "binary",
                    "description": "The .proto definition file to upload and dynamically inspect size attributes"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Calculated workspace state mapping rendering data models",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          }
        }
      }
    },
    "/api/cost/alb": {
      "post": {
        "tags": ["Cloud Service Cost"],
        "summary": "Calculate Application Load Balancer (ALB) monthly costs",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AlbCostRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "ALB cost breakdown generated successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ServiceCostResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/aws/ec2-instances": {
      "get": {
        "tags": ["Cloud TCO Resources"],
        "summary": "Fetch live or fallback pricing data for compute EC2 instances",
        "responses": {
          "200": {
            "description": "List of compute instances with dynamic billing specs",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": true
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/aws/alb-pricing": {
      "get": {
        "tags": ["Cloud TCO Resources"],
        "summary": "Get baseline AWS ALB resource pricing structural schemas",
        "responses": {
          "200": {
            "description": "ALB cost metrics map retrieved",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          }
        }
      }
    },
    "/api/aws/database-backup-pricing": {
      "get": {
        "tags": ["Cloud TCO Resources"],
        "summary": "Get database storage and snapshot backup pricing frameworks",
        "responses": {
          "200": {
            "description": "Database backup dimensions retrieved",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          }
        }
      }
    },
    "/api/aws/security-services": {
      "get": {
        "tags": ["Cloud TCO Resources"],
        "summary": "Fetch baseline costs for AWS native protection services",
        "responses": {
          "200": {
            "description": "Security dimensions retrieved",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          }
        }
      }
    },
    "/api/aws/cost-optimisation": {
      "get": {
        "tags": ["Cloud TCO Resources"],
        "summary": "Fetch cost optimization rules and FinOps tactic strategies",
        "responses": {
          "200": {
            "description": "FinOps strategic parameters mapped",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          }
        }
      }
    },
    "/api/aws/caching-pricing": {
      "get": {
        "tags": ["Cloud TCO Resources"],
        "summary": "Retrieve baseline cache instance tier allocations",
        "responses": {
          "200": {
            "description": "Caching pricing metrics map retrieved",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          }
        }
      }
    },
    "/api/tco/effective-rps": {
      "post": {
        "tags": ["Effective Volume Metrics"],
        "summary": "Evaluate structural network and processing overhead scaling limits",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EffectiveRequestPerSecondRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Calculated effective request capacity allocations",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EffectiveRequestPerSecondResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/finops/container-discounts": {
      "post": {
        "tags": ["FinOps Economic Rules"],
        "summary": "Compare Reserved Instances vs Savings Plans billing reductions",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DiscountRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Optimized tier selection recommendations complete",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DiscountResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/portfolio/roi": {
      "post": {
        "tags": ["Portfolio Unit Economics"],
        "summary": "Evaluate macro profit economics over heterogeneous service bundles",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PortfolioRoiRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Aggregated ROI matrices computed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PortfolioRoiResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/cost/unit-economics": {
      "post": {
        "tags": ["Portfolio Unit Economics"],
        "summary": "Calculate micro metrics comparing request-level expenses vs consumer ARPU constraints",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UnitEconomicsRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Affordability impact categorizations determined",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UnitEconomicsResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/reliability/tactic-mappings": {
      "get": {
        "tags": ["Architectural Quality Tradeoffs"],
        "summary": "List reliability score matrices for streaming protocols",
        "responses": {
          "200": {
            "description": "Reliability evaluations returned",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ReliabilityTradeoffDTO"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/resiliency/tactic-mappings": {
      "get": {
        "tags": ["Architectural Quality Tradeoffs"],
        "summary": "List resiliency pattern evaluations",
        "responses": {
          "200": {
            "description": "Resiliency mappings returned",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ResiliencyTradeoffDTO"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/security/tactic-mappings": {
      "get": {
        "tags": ["Architectural Quality Tradeoffs"],
        "summary": "List security engineering constraints over specific channels",
        "responses": {
          "200": {
            "description": "Security qualitative indexes returned",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/SecurityTradeoffsDTO"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/cost/tactic-contributions": {
      "post": {
        "tags": ["Tactics Cost Contributions"],
        "summary": "Quantify incremental network egress additions induced by specific design implementations",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TacticContributionRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Total tactic network deviations evaluated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TacticContributionResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/session/tactics": {
      "post": {
        "tags": ["Session Management"],
        "summary": "Persist selected architectural decisions into HTTP user session scope",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ArchitecturalDecisionsDTO"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Session initialized with provided tactical configurations successfully"
          }
        }
      },
      "get": {
        "tags": ["Session Management"],
        "summary": "Retrieve active target architectural decisions from context state",
        "responses": {
          "200": {
            "description": "Active session DTO object configuration state maps",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ArchitecturalDecisionsDTO"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": ["Session Management"],
        "summary": "Clear and purge active architectural decisions tracked in the contextual storage",
        "responses": {
          "204": {
            "description": "Session context cleared successfully"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AlbCostRequest": {
        "type": "object",
        "properties": {
          "albCount": { "type": "integer", "default": 1 },
          "lcuPerHour": { "type": "number", "default": 0.0 },
          "fixedPerMonthUsd": { "type": "number", "default": 16.20 },
          "lcuPerHourUsd": { "type": "number", "default": 0.008 }
        }
      },
      "ServiceCostResponse": {
        "type": "object",
        "properties": {
          "monthlyTotalUsd": { "type": "number" },
          "breakdownLines": {
            "type": "array",
            "items": { "type": "string" }
          },
          "sessionStorageKey": { "type": "string" },
          "summaryLabel": { "type": "string" }
        }
      },
      "EffectiveRequestPerSecondRequest": {
        "type": "object",
        "properties": {
          "baselineRps": { "type": "integer" },
          "tlsEnabled": { "type": "boolean" },
          "mtlsEnabled": { "type": "boolean" },
          "tlsReconnectsPerHour": { "type": "number" },
          "oauthTokenValidationMode": { "type": "string", "enum": ["LOCAL_VALIDATION", "REMOTE_INTROSPECTION", "OPA_INTEGRATION"] }
        }
      },
      "EffectiveRequestPerSecondResponse": {
        "type": "object",
        "properties": {
          "effectiveRps": { "type": "integer" },
          "handshakeExtra": { "type": "integer" },
          "oauthExtra": { "type": "integer" },
          "rpsWasAdjusted": { "type": "boolean" },
          "breakdown": {
            "type": "array",
            "items": { "type": "string" }
          },
          "oauthPreview": { "type": "string" }
        }
      },
      "DiscountRequest": {
        "type": "object",
        "properties": {
          "currentMonthlyContainerCostUsd": { "type": "number" },
          "riStandard1yr": { "type": "boolean" },
          "riStandard3yr": { "type": "boolean" },
          "riConvertible1yr": { "type": "boolean" },
          "savingsPlan1yr": { "type": "boolean" },
          "savingsPlan3yr": { "type": "boolean" }
        }
      },
      "DiscountResponse": {
        "type": "object",
        "properties": {
          "bestStrategy": { "type": "string" },
          "maxDiscountPct": { "type": "number" },
          "calculatedMonthlySavingUsd": { "type": "number" },
          "netMonthlyContainerCostUsd": { "type": "number" }
        }
      },
      "PortfolioRoiRequest": {
        "type": "object",
        "properties": {
          "services": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ServiceEntry"
            }
          },
          "finopsMonthlySaving": { "type": "number" },
          "ec2BaselineSpend": { "type": "number" }
        }
      },
      "ServiceEntry": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "buc": { "type": "string" },
          "tco": { "type": "number" },
          "revenuePerUserMonth": { "type": "number" },
          "consumers": { "type": "integer" },
          "rps": { "type": "number" }
        }
      },
      "PortfolioRoiResponse": {
        "type": "object",
        "properties": {
          "totalMonthlyTco": { "type": "number" },
          "totalMonthlyRevenue": { "type": "number" },
          "monthlyNetProfit": { "type": "number" },
          "monthlyRoi": { "type": "number" },
          "finopsAdjustedTco": { "type": "number" },
          "finopsAdjustedRoi": { "type": "number" },
          "finopsRoiImprovementPct": { "type": "number" },
          "serviceBreakdown": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ServiceRoiEntry"
            }
          },
          "note": { "type": "string" }
        }
      },
      "ServiceRoiEntry": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "buc": { "type": "string" },
          "tco": { "type": "number" },
          "consumers": { "type": "integer" },
          "rps": { "type": "number" },
          "arpu": { "type": "number" },
          "monthlyRevenue": { "type": "number" },
          "roi": { "type": "number" },
          "tcoShare": { "type": "number" }
        }
      },
      "UnitEconomicsRequest": {
        "type": "object",
        "properties": {
          "egressTransferCostUsd": { "type": "number" },
          "cloudInfraCostUsd": { "type": "number" },
          "finopsSavingUsd": { "type": "number" },
          "effectiveRps": { "type": "number" },
          "consumerCount": { "type": "integer" },
          "revenuePerUserPerMonth": { "type": "number" }
        }
      },
      "UnitEconomicsResponse": {
        "type": "object",
        "properties": {
          "totalCostPerMonth": { "type": "number" },
          "costPerUser": { "type": "number" },
          "costPerMillionRequests": { "type": "number" },
          "affordabilityImpact": { "type": "string" }
        }
      },
      "ReliabilityTradeoffDTO": {
        "type": "object",
        "properties": {
          "tacticName": { "type": "string" },
          "patternName": { "type": "string" },
          "score": { "type": "integer" },
          "description": { "type": "string" }
        }
      },
      "ResiliencyTradeoffDTO": {
        "type": "object",
        "properties": {
          "tacticName": { "type": "string" },
          "patternName": { "type": "string" },
          "score": { "type": "integer" },
          "description": { "type": "string" }
        }
      },
      "SecurityTradeoffsDTO": {
        "type": "object",
        "properties": {
          "tacticName": { "type": "string" },
          "patternName": { "type": "string" },
          "score": { "type": "integer" },
          "description": { "type": "string" }
        }
      },
      "TacticContributionRequest": {
        "type": "object",
        "properties": {
          "protoResponseSizeEffectiveBytes": { "type": "integer" },
          "retryStrategyEnabled": { "type": "boolean" },
          "tlsEnabled": { "type": "boolean" },
          "oauthEnabled": { "type": "boolean" }
        }
      },
      "TacticContributionResponse": {
        "type": "object",
        "properties": {
          "placeholderResponseBytes": { "type": "integer" },
          "usedPlaceholderBytes": { "type": "boolean" },
          "totalTacticNetworkingDeltaUsd": { "type": "number" },
          "contributions": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "tacticName": { "type": "string" },
                "estimatedMonthlyCostUsd": { "type": "number" }
              }
            }
          }
        }
      },
      "ArchitecturalDecisionsDTO": {
        "type": "object",
        "description": "Comprehensive tactical footprint containing communication and topology states initialized inside session buffers",
        "properties": {
          "grpcPattern": { "type": "string", "example": "UNARY" },
          "securityTactics": { "type": "object" },
          "resiliencyPatterns": { "type": "object" },
          "reliabilityTactics": { "type": "object" }
        }
      }
    }
  }
}